# ==============================================================================
# AGENTPAY Frontend Service Environment Variables Template
# Copy to frontend/.env.local for local frontend development.
# ==============================================================================

# Backend FastAPI API Endpoint Base URL (Browser Accessible)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Public Configuration (Browser Scope Only)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Server Port
PORT=3000
