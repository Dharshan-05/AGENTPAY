# AGENTPAY Backend Environment Configuration

# Application Settings
APP_NAME="AGENTPAY API"
APP_VERSION="1.0.0"
APP_ENV="development" # Options: development, test, staging, production, local
DEBUG="false"
DESCRIPTION="Backend API platform for secure autonomous agentic commerce and payment infrastructure."

# Server Settings
HOST="0.0.0.0"
PORT="8000"

# API Route Prefixes
API_PREFIX="/api"
API_V1_PREFIX="/v1"

# Documentation Settings
DOCS_ENABLED="true"
REDOC_ENABLED="true"
OPENAPI_ENABLED="true"
DOCS_URL="/docs"
REDOC_URL="/redoc"
OPENAPI_URL="/openapi.json"

# Logging Foundation Settings
LOG_LEVEL="INFO" # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Database Foundation Settings
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_pass"
POSTGRES_DB="agentpay_dev"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Connection URL (Supports local PostgreSQL or Supabase Managed Cloud)
# Local PostgreSQL: postgresql://postgres:postgres_dev_pass@localhost:5432/agentpay_dev
# Supabase Direct: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Supabase Pooled: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres_dev_pass@localhost:5432/agentpay_dev"

# Redis Foundation Settings
REDIS_URL="redis://localhost:6379"

# Security & CORS Foundation Settings
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["*"]
