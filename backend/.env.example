# Monorepo Development Environment Template
NODE_ENV=development
PORT=4000

# PostgreSQL Container Database URL
DATABASE_URL=postgresql://postgres:postgres_dev_pass@localhost:5432/agentpay_dev?sslmode=disable

# Redis Cache Container URL
REDIS_URL=redis://localhost:6379

# Cryptographic Authentication Secrets
JWT_SECRET=super_secret_jwt_key_minimum_32_bytes_long_string_for_dev_mode
HMAC_AGENT_SECRET=super_secret_hmac_agent_signing_key_for_dev

# Razorpay Test Mode Credentials (NEVER USE PRODUCTION SECRETS HERE)
RAZORPAY_KEY_ID=rzp_test_mock_12345678
RAZORPAY_KEY_SECRET=rzp_test_secret_mock_87654321
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_mock_112233

# AI & LLM Provider Settings
OPENAI_API_KEY=sk-mock-development-key-never-commit-real-keys
MODEL_NAME=gpt-4o-mini

# Observability Configuration
OTEL_SERVICE_NAME=agentpay-dev
LOG_LEVEL=info
