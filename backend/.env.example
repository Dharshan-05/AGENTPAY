# ==============================================================================
# AGENTPAY Backend Service Environment Variables Template
# Copy to backend/.env for local standalone backend execution.
# ==============================================================================

APP_NAME="AGENTPAY API"
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentpay_dev

# Connection URL (Supports local PostgreSQL or Supabase Managed Cloud)
# Local PostgreSQL: postgresql://postgres:postgres_dev_pass@localhost:5432/agentpay_dev
# Supabase Direct Connection: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Supabase Pooled Connection: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres_dev_pass@localhost:5432/agentpay_dev

# Supabase Credentials (Backend Server Scope Only — NEVER expose to frontend)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Security Settings
JWT_SECRET=dev_jwt_secret_change_in_production_32chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Security CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
