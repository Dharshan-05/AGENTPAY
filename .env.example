# ==============================================================================
# AGENTPAY Root Infrastructure Environment Variables Template
# Copy to .env for local Docker Compose execution. Never commit secrets!
# ==============================================================================

# Application Environment (development, test, staging, production, local)
APP_ENV=development
DEBUG=false

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (Local PostgreSQL Default)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_pass
POSTGRES_HOST=agentpay-postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentpay_dev

# Canonical Database URL (Local or Supabase PostgreSQL)
# Local Docker Postgres: postgresql://postgres:postgres_dev_pass@agentpay-postgres:5432/agentpay_dev
# Supabase Direct PostgreSQL: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Supabase Transaction Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres_dev_pass@agentpay-postgres:5432/agentpay_dev

# Supabase Credentials (Cloud Managed Option - Backend Server Scope Only)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# SUPABASE_SERVICE_ROLE_KEY is BACKEND-ONLY. NEVER EXPOSE TO FRONTEND!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key_here

# Redis Configuration
REDIS_URL=redis://agentpay-redis:6379/0

# Security & Cryptographic Key Settings (Must be 32+ chars in production)
JWT_SECRET=dev_jwt_secret_change_in_production_32chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
